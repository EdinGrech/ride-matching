{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (name) (rate(k6_http_reqs_total{flow=\"ride-lifecycle\",testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "{{name}}", "refId": "A" }],
      "title": "Requests Per Second By Operation",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (status) (rate(k6_http_reqs_total{flow=\"ride-lifecycle\",testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "HTTP {{status}}", "refId": "A" }],
      "title": "Requests Per Second By Status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "100 * sum(rate(k6_http_reqs_total{flow=\"ride-lifecycle\",testid=~\"$testid\",expected_response=\"false\"}[$__rate_interval])) / sum(rate(k6_http_reqs_total{flow=\"ride-lifecycle\",testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "failed", "refId": "A" }],
      "title": "HTTP Failure Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(k6_http_reqs_total{flow=\"ride-lifecycle\",testid=~\"$testid\",status=\"409\"}[$__rate_interval]))", "legendFormat": "409 conflicts", "refId": "A" },
        { "expr": "sum(rate(k6_http_reqs_total{flow=\"ride-lifecycle\",testid=~\"$testid\",status=\"0\"}[$__rate_interval]))", "legendFormat": "transport timeouts", "refId": "B" }
      ],
      "title": "Conflict And Timeout Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "1000 * max by (name) (k6_http_req_duration_p95{flow=\"ride-lifecycle\",testid=~\"$testid\"})", "legendFormat": "{{name}}", "refId": "A" }],
      "title": "p95 Request Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "1000 * max by (name) (k6_http_req_duration_max{flow=\"ride-lifecycle\",testid=~\"$testid\"})", "legendFormat": "{{name}}", "refId": "A" }],
      "title": "Maximum Request Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "100 * k6_checks_rate{testid=~\"$testid\"}", "legendFormat": "{{check}}", "refId": "A" }],
      "title": "Check Pass Rate By Assertion",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(k6_ride_lifecycles_completed_total{testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "completed", "refId": "A" },
        { "expr": "sum by (reason) (rate(k6_ride_lifecycles_aborted_total{testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "aborted: {{reason}}", "refId": "B" }
      ],
      "title": "Lifecycle Outcome Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(k6_data_received_total{testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "received", "refId": "A" },
        { "expr": "sum(rate(k6_data_sent_total{testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "sent", "refId": "B" }
      ],
      "title": "Network Throughput",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["k6", "ride-matching", "timeline"],
  "templating": {
    "list": [
      {
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(k6_http_reqs_total{flow=\"ride-lifecycle\"}, testid)",
        "includeAll": true,
        "label": "Test run",
        "multi": false,
        "name": "testid",
        "options": [],
        "query": { "query": "label_values(k6_http_reqs_total{flow=\"ride-lifecycle\"}, testid)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "title": "Ride Load Test Timeline",
  "uid": "ride-load-test-timeline",
  "version": 1
}
