{
  "annotations": { "list": [] },
  "description": "Open this dashboard through the URL printed by run-benchmark.ps1. k6 panels are scoped to one population-ramp run; cAdvisor container metrics are live.",
  "editable": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (name) (rate(k6_http_reqs_total{flow=~\"$flow\",flow!=\"actor-setup\",implementation=~\"$implementation\",testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "{{name}}", "refId": "A" }],
      "title": "Achieved Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "1000 * max by (name) (k6_http_req_duration_p95{flow=~\"$flow\",flow!=\"actor-setup\",implementation=~\"$implementation\",testid=~\"$testid\"})", "legendFormat": "{{name}}", "refId": "A" }],
      "title": "p95 Request Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "100 * sum(rate(k6_http_reqs_total{flow=~\"$flow\",flow!=\"actor-setup\",implementation=~\"$implementation\",testid=~\"$testid\",expected_response=\"false\"}[$__rate_interval])) / sum(rate(k6_http_reqs_total{flow=~\"$flow\",flow!=\"actor-setup\",implementation=~\"$implementation\",testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "failed", "refId": "A" }],
      "title": "Failure Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "1000 * max by (name) (k6_http_req_duration_p50{flow=~\"$flow\",flow!=\"actor-setup\",implementation=~\"$implementation\",testid=~\"$testid\"})", "legendFormat": "{{name}}", "refId": "A" }],
      "title": "p50 Request Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "1000 * max by (name) (k6_http_req_duration_p99{flow=~\"$flow\",flow!=\"actor-setup\",implementation=~\"$implementation\",testid=~\"$testid\"})", "legendFormat": "{{name}}", "refId": "A" }],
      "title": "p99 Request Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "A run fails when any lifecycle aborts. This ratio is only meaningful for the population-ramp flow.",
      "fieldConfig": { "defaults": { "decimals": 2, "max": 100, "min": 0, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "100 * sum(increase(k6_ride_lifecycles_completed_total{flow=~\"$flow\",implementation=~\"$implementation\",testid=~\"$testid\"}[$__range])) / (sum(increase(k6_ride_lifecycles_completed_total{flow=~\"$flow\",implementation=~\"$implementation\",testid=~\"$testid\"}[$__range])) + sum(increase(k6_ride_lifecycles_aborted_total{flow=~\"$flow\",implementation=~\"$implementation\",testid=~\"$testid\"}[$__range])))", "refId": "A" }],
      "title": "Lifecycle Completion Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cores" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{job=\"cadvisor\",container_label_com_docker_compose_service=\"api\",image!=\"\"}[$__rate_interval]))", "legendFormat": "api", "refId": "A" }],
      "title": "API Container CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum(container_memory_working_set_bytes{job=\"cadvisor\",container_label_com_docker_compose_service=\"api\",image!=\"\"})", "legendFormat": "api", "refId": "A" }],
      "title": "API Container Working-Set Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "id": 7,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "sum(increase(k6_dropped_iterations_total{implementation=~\"$implementation\",testid=~\"$testid\"}[$__range]))", "refId": "A" }],
      "title": "Dropped Iterations",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "id": 8,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "sum(increase(k6_ride_lifecycles_aborted_total{flow=~\"$flow\",implementation=~\"$implementation\",testid=~\"$testid\"}[$__range]))", "refId": "A" }],
      "title": "Aborted Lifecycles",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "1000 * max by (name) (k6_http_req_duration_p50{flow=~\"$flow\",flow!=\"actor-setup\",implementation=~\"$implementation\",testid=~\"$testid\"})", "legendFormat": "{{name}}", "refId": "A" }],
      "title": "p50 Request Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "1000 * max by (name) (k6_http_req_duration_p99{flow=~\"$flow\",flow!=\"actor-setup\",implementation=~\"$implementation\",testid=~\"$testid\"})", "legendFormat": "{{name}}", "refId": "A" }],
      "title": "p99 Request Latency",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["benchmark", "cadvisor", "k6", "ride-matching"],
  "templating": {
    "list": [
      {
        "allValue": ".+",
        "current": { "selected": true, "text": "population-ramp", "value": "population-ramp" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(k6_http_reqs_total, flow)",
        "includeAll": true,
        "label": "Flow",
        "multi": false,
        "name": "flow",
        "options": [],
        "query": { "query": "label_values(k6_http_reqs_total, flow)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(k6_http_reqs_total{flow=~\"$flow\"}, implementation)",
        "includeAll": true,
        "label": "Implementation",
        "multi": false,
        "name": "implementation",
        "options": [],
        "query": { "query": "label_values(k6_http_reqs_total{flow=~\"$flow\"}, implementation)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(k6_http_reqs_total{flow=~\"$flow\",implementation=~\"$implementation\"}, testid)",
        "includeAll": true,
        "label": "Test run",
        "multi": false,
        "name": "testid",
        "options": [],
        "query": { "query": "label_values(k6_http_reqs_total{flow=~\"$flow\",implementation=~\"$implementation\"}, testid)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "title": "Ride Benchmark",
  "uid": "ride-benchmark",
  "version": 1
}
