{
  "annotations": { "list": [] },
  "description": "Run-scoped capacity evidence. The runner prints this dashboard with the implementation, run ID, and exact time range selected.",
  "editable": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "k6_simulated_users_active{flow=\"population-ramp\",scenario=\"population_metrics\",implementation=~\"$implementation\",testid=~\"$testid\"}", "legendFormat": "active users", "refId": "A" }],
      "title": "Active Simulated Users",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (name) (rate(k6_http_reqs_total{flow=\"population-ramp\",implementation=~\"$implementation\",testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "{{name}}", "refId": "A" }],
      "title": "Achieved Request Rate By Endpoint",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0 }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "sum(increase(k6_http_reqs_total{flow=\"population-ramp\",implementation=~\"$implementation\",testid=~\"$testid\",expected_response=\"false\"}[$__range])) or vector(0)", "refId": "A" }],
      "title": "Application Request Failures",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "1000 * max by (name) (k6_http_req_duration_p50{flow=\"population-ramp\",implementation=~\"$implementation\",testid=~\"$testid\"})", "legendFormat": "{{name}}", "refId": "A" }],
      "title": "p50 Request Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "1000 * max by (name) (k6_http_req_duration_p95{flow=\"population-ramp\",implementation=~\"$implementation\",testid=~\"$testid\"})", "legendFormat": "{{name}}", "refId": "A" }],
      "title": "p95 Request Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "1000 * max by (name) (k6_http_req_duration_p99{flow=\"population-ramp\",implementation=~\"$implementation\",testid=~\"$testid\"})", "legendFormat": "{{name}}", "refId": "A" }],
      "title": "p99 Request Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(k6_ride_lifecycles_completed_total{flow=\"population-ramp\",implementation=~\"$implementation\",testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "completed", "refId": "A" },
        { "expr": "sum by (reason) (rate(k6_ride_lifecycles_aborted_total{flow=\"population-ramp\",implementation=~\"$implementation\",testid=~\"$testid\"}[$__rate_interval])) or vector(0)", "legendFormat": "aborted", "refId": "B" }
      ],
      "title": "Lifecycle Outcome Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cores" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{job=\"cadvisor\",container_label_com_docker_compose_service=\"api\",image!=\"\"}[$__rate_interval]))", "legendFormat": "api", "refId": "A" }],
      "title": "API Container CPU",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum(container_memory_working_set_bytes{job=\"cadvisor\",container_label_com_docker_compose_service=\"api\",image!=\"\"})", "legendFormat": "api", "refId": "A" }],
      "title": "API Container Working-Set Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single" } },
      "targets": [{ "expr": "sum(rate(k6_http_reqs_total{flow=\"population-ramp\",implementation=~\"$implementation\",testid=~\"$testid\"}[$__rate_interval]))", "legendFormat": "all application requests", "refId": "A" }],
      "title": "Total Application Request Rate",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["benchmark", "cadvisor", "k6", "ride-matching"],
  "templating": {
    "list": [
      {
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(k6_http_reqs_total{flow=\"population-ramp\"}, implementation)",
        "includeAll": true,
        "label": "Implementation",
        "multi": false,
        "name": "implementation",
        "options": [],
        "query": { "query": "label_values(k6_http_reqs_total{flow=\"population-ramp\"}, implementation)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(k6_http_reqs_total{flow=\"population-ramp\",implementation=~\"$implementation\"}, testid)",
        "includeAll": true,
        "label": "Test run",
        "multi": false,
        "name": "testid",
        "options": [],
        "query": { "query": "label_values(k6_http_reqs_total{flow=\"population-ramp\",implementation=~\"$implementation\"}, testid)", "refId": "StandardVariableQuery" },
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "title": "Ride Benchmark",
  "uid": "ride-benchmark",
  "version": 3
}
